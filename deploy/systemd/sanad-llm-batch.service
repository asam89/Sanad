# Sanad self-hosted inference — batch model (SPEC §4.3)
# Install: sudo cp deploy/systemd/sanad-llm-batch.service /etc/systemd/system/ && sudo systemctl enable --now sanad-llm-batch
[Unit]
Description=Sanad llama-server (batch)
After=network.target

[Service]
Type=simple
User=sanad
Group=sanad
# NEVER change --host. Loopback only.
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --host 127.0.0.1 --port 8082 \
  --model /opt/models/Qwen2.5-7B-Instruct-Q4_K_M-00001-of-00002.gguf \
  --ctx-size 8192 --threads 4 --jinja \
  --log-disable
Restart=on-failure
RestartSec=5
Nice=5
MemoryMax=10G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/models /opt/llama.cpp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
