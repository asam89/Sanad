<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac Mini demo: `next start` on :3100, restarts on crash. See docs/demo-macmini.md §7. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.faezsports.sanad</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__/npm</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SANAD_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/sanad.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/sanad.log</string>
</dict>
</plist>
