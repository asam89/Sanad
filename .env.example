# --- Database -----------------------------------------------------------------
# Sanad's own tables. Mac Mini demo: a local Postgres. VM: the "sanad" schema.
DATABASE_URL=postgresql://sanad:sanad@localhost:5432/sanad
# Platform tables — READ ONLY role (SELECT only). Not used by the demo.
# PLATFORM_DATABASE_URL=postgresql://sanad_ro:...@host:5432/postgres?schema=public

# --- Twilio WhatsApp Business API ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public HTTPS URL Twilio posts to (Tailscale Funnel / ngrok / Cloudflare tunnel on the Mac Mini).
SANAD_PUBLIC_URL=https://your-mac.tailnet.ts.net
# Where escalations are sent. Leave unset to only log them.
SANAD_ADMIN_WHATSAPP=whatsapp:+1XXXXXXXXXX

# --- Admin console (/admin) -----------------------------------------------------
# Basic auth, user "admin". Unset disables /admin entirely.
SANAD_ADMIN_PASSWORD=change-me

# --- LLM (loopback only; non-loopback hosts are refused at startup) -------------
# local = any OpenAI-compatible server on localhost. mock = scripted, for tests.
LLM_PROVIDER=local
# Mac Mini (Ollama):
LLM_CHAT_URL=http://127.0.0.1:11434
LLM_EMBED_URL=http://127.0.0.1:11434
LLM_CHAT_MODEL=qwen2.5:7b
LLM_EMBED_MODEL=nomic-embed-text
# OCI VM (llama-server, model names ignored):
# LLM_CHAT_URL=http://127.0.0.1:8081
# LLM_BATCH_URL=http://127.0.0.1:8082
# LLM_EMBED_URL=http://127.0.0.1:8083

FAEZSPORTS_REGISTRATION_URL=https://faezsports.com
