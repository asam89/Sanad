# Sanad's own tables (schema "sanad") — read/write role
DATABASE_URL=postgresql://sanad_rw:...@host:6543/postgres?schema=sanad&pgbouncer=true
DIRECT_URL=postgresql://sanad_rw:...@host:5432/postgres?schema=sanad
# Platform tables — READ ONLY role (SELECT only). Never a writable role here.
PLATFORM_DATABASE_URL=postgresql://sanad_ro:...@host:6543/postgres?schema=public&pgbouncer=true

# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
SANAD_PUBLIC_URL=https://sanad.faezsports.com
SANAD_ADMIN_WHATSAPP=whatsapp:+1XXXXXXXXXX

# LLM (all localhost only)
LLM_PROVIDER=local
LLM_CHAT_URL=http://127.0.0.1:8081
LLM_BATCH_URL=http://127.0.0.1:8082
LLM_EMBED_URL=http://127.0.0.1:8083

# Valkey
VALKEY_URL=redis://127.0.0.1:6379
