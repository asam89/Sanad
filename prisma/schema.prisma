// Sanad-owned tables. Lives in its own Postgres schema ("sanad").
// Platform tables are NEVER defined or migrated here — see prisma/platform.prisma (introspection only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  WHATSAPP
  INSTAGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum RoutePath {
  FAST
  AI
  ESCALATION
  THROTTLE
  SYSTEM
}

enum ConversationState {
  BOT
  ESCALATED
  HUMAN_TAKEOVER
}

/// One thread per (channel, external address). The external address is the
/// only key used to scope household data — see SPEC §5.2 privacy rule.
model Conversation {
  id              String            @id @default(cuid())
  channel         Channel
  externalAddress String // e.g. "whatsapp:+14165551234" or an IG scoped user id
  state           ConversationState @default(BOT)
  optedOut        Boolean           @default(false)
  lastInboundAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        Message[]
  escalations     Escalation[]

  @@unique([channel, externalAddress])
  @@index([state])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String           @db.Text
  providerSid    String?          @unique // Twilio MessageSid — idempotency key for inbound retries
  routePath      RoutePath?
  intent         String?
  ttfbMs         Int? // time to first token (AI path only)
  latencyMs      Int?
  toolCalls      Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

enum EscalationReason {
  UNGROUNDED
  NO_RETRIEVAL
  KEYWORD
  REPEATED_QUESTION
  TOOL_ERROR
  TIMEOUT
}

model Escalation {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         EscalationReason
  excerpt        String           @db.Text
  assignedTo     String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([resolvedAt])
}

model KnowledgeDoc {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  category    String // "policy" | "faq" | "program" | "rules" | "venue"
  body        String           @db.Text
  isPublished Boolean          @default(false)
  updatedAt   DateTime         @updatedAt
  chunks      KnowledgeChunk[]
}

/// Embeddings are stored as a JSON float array and ranked in-process; the
/// corpus is a few hundred chunks so this beats requiring pgvector on every
/// host. Swap to pgvector when the corpus outgrows it.
model KnowledgeChunk {
  id        String       @id @default(cuid())
  docId     String
  doc       KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  ordinal   Int
  content   String       @db.Text
  embedding Json?
  model     String? // embedding model that produced the vector

  @@index([docId])
}

// ---------------------------------------------------------------------------
// Program data. On the VM this is replaced by the read-only platform mirror
// (prisma/platform.prisma). For the Mac Mini demo Sanad owns a small copy,
// seeded from prisma/seed.ts. Tools only ever read from these tables.
// ---------------------------------------------------------------------------

model Venue {
  id          String    @id @default(cuid())
  name        String
  address     String
  parking     String?
  accessNotes String?
  programs    Program[]
}

model Program {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  sport           String
  ageRange        String // "9-12"
  dayOfWeek       String // "Saturday"
  timeOfDay       String // "10:00-11:30"
  priceCents      Int
  capacity        Int
  registrationUrl String
  startsOn        DateTime
  isOpen          Boolean   @default(true)
  venueId         String
  venue           Venue     @relation(fields: [venueId], references: [id])
  sessions        Session[]
  registrations   Registration[]
}

model Session {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  note      String?

  @@index([programId, startsAt])
}

enum PaymentStatus {
  PAID
  UNPAID
  REFUNDED
}

/// Household link: parentPhone is the WhatsApp number and the ONLY lookup key
/// the model can use (SPEC §5.2 privacy rule).
model Registration {
  id             String        @id @default(cuid())
  programId      String
  program        Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  childFirstName String
  childLastName  String
  childAge       Int
  parentName     String
  parentPhone    String // E.164, e.g. +14165550100
  parentEmail    String
  paymentStatus  PaymentStatus @default(UNPAID)
  registeredAt   DateTime      @default(now())

  @@index([parentPhone])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
